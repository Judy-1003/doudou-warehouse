.top-eyebrow { margin-top: 8rpx; }.stats-title { margin-bottom: 24rpx; }.range-segment { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6rpx; padding: 6rpx; border: 2rpx solid var(--line); border-radius: 38rpx; background: var(--paper-light); }.range-item { padding: 14rpx; border-radius: 30rpx; color: var(--sub); text-align: center; }.range-item.active { color: #fbf5e8; background: linear-gradient(160deg, #6b4c37, var(--brown)); }.receipt { position: relative; margin: 24rpx 0 20rpx; padding: 30rpx; overflow: hidden; border-radius: 30rpx; color: #f6eede; background: linear-gradient(140deg, #55402f, #3f2d1e); box-shadow: 0 18rpx 38rpx -24rpx rgba(45,30,18,.9); }.receipt-label { opacity: .64; font-size: 20rpx; letter-spacing: 4rpx; }.receipt-cups { margin: 12rpx 0 2rpx; font-size: 84rpx; line-height: 1; }.receipt-cups text { margin-left: 8rpx; opacity: .7; font-size: 28rpx; }.receipt-sub { opacity: .72; font-size: 22rpx; }.stamp { position: absolute; right: 28rpx; top: 50%; display: flex; align-items: center; justify-content: center; flex-direction: column; width: 150rpx; height: 150rpx; border: 3rpx dashed rgba(246,238,222,.5); border-radius: 50%; transform: translateY(-50%) rotate(-9deg); }.stamp text:first-child { font-size: 34rpx; font-weight: 600; }.stamp text:last-child { margin-top: 4rpx; opacity: .66; font-size: 16rpx; letter-spacing: 3rpx; }.metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }.metric-grid > view { display: flex; align-items: center; flex-direction: column; padding: 22rpx 10rpx; border: 2rpx solid var(--line); border-radius: 26rpx; background: var(--card); }.metric-icon { color: var(--brown); font-size: 30rpx; }.metric-value { margin-top: 8rpx; font-size: 32rpx; font-weight: 600; }.metric-unit { margin-left: 2rpx; color: var(--dim); font-size: 18rpx; }.metric-label { margin-top: 5rpx; color: var(--dim); font-size: 19rpx; letter-spacing: 2rpx; }.totals-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.totals-grid > view { display: flex; flex-direction: column; gap: 8rpx; padding: 22rpx 24rpx; border: 2rpx dashed var(--line); border-radius: 22rpx; background: var(--paper-light); }.totals-grid view > text:first-child { color: var(--dim); font-size: 20rpx; }.totals-grid view > text:last-child { font-size: 30rpx; font-weight: 600; }.totals-grid .wide { grid-column: 1 / -1; }.total-unit { display: block; margin-top: 4rpx; color: var(--dim); font-size: 19rpx; font-weight: 400; }
.day-list { padding: 4rpx 26rpx; }
.day-row { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; border-bottom: 2rpx dashed var(--line-light); }
.day-row:last-child { border-bottom: 0; }
.day-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.day-copy > text:last-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.day-tail { display: flex; flex: none; align-items: center; gap: 12rpx; color: var(--sub); }
.compact-empty { padding: 34rpx 24rpx; }
