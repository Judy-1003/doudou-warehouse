.hero-card { margin-top: 8rpx; padding: 30rpx; }.bean-title-row { display: flex; align-items: baseline; gap: 16rpx; margin: 16rpx 0 8rpx; }.bean-title { flex: 0 1 auto; overflow: hidden; font-size: 44rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }.roast-chip { flex: none; padding: 6rpx 16rpx; border-radius: 12rpx; color: var(--brown); background: #f0e2c9; font-size: 21rpx; }.flavors { margin-top: 16rpx; }.flavors text { display: inline-block; margin: 0 10rpx 8rpx 0; padding: 7rpx 16rpx; border-radius: 14rpx; color: var(--brown-light); background: #f1e3cc; font-size: 20rpx; }.detail-card, .timeline-card { padding: 8rpx 28rpx; }.timeline-row { display: flex; align-items: center; gap: 20rpx; min-height: 82rpx; border-bottom: 2rpx dashed var(--line-light); }.timeline-dot { flex: none; width: 18rpx; height: 18rpx; border: 4rpx solid var(--line); border-radius: 50%; }.timeline-dot.done { border-color: var(--brown); background: var(--brown); }.timeline-label { flex: 1; }.lifecycle-summary { margin-top: 8rpx; }.rating-card { padding: 26rpx; }.rating-text { margin-left: 10rpx; color: #c8922c; }.note-label { margin-top: 28rpx; color: var(--sub); font-size: 23rpx; }.note-text { min-height: 56rpx; margin-top: 8rpx; color: var(--ink); line-height: 1.7; }.edit-note { margin-top: 20rpx; }.brew-row { display: flex; align-items: center; justify-content: space-between; }.brew-tail { display: flex; flex: none; align-items: center; gap: 12rpx; color: var(--sub); }.note-save { margin-top: 24rpx; }
.hero-actions { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx dashed var(--line-light); }
.storage-switch { display: flex; flex: none; padding: 4rpx; border: 2rpx solid var(--line); border-radius: 22rpx; background: var(--paper-light); }
.storage-item { padding: 10rpx 24rpx; border-radius: 18rpx; color: var(--sub); font-size: 22rpx; }
.storage-item.active { color: #fbf5e8; background: linear-gradient(160deg, #6b4c37, var(--brown)); }
.stock-edit { flex: none; padding: 12rpx 26rpx; border: 2rpx solid rgba(90,65,48,.28); border-radius: 20rpx; color: var(--brown); background: rgba(238,226,204,.7); font-size: 22rpx; }
.stock-edit:active { opacity: .84; }
.stock-hint { margin-top: 10rpx; }
.stock-cancel { margin-top: 16rpx; }
