.hero-shell { position: relative; overflow: hidden; margin-top: 4rpx; padding: 30rpx 24rpx 22rpx 30rpx; border: 2rpx solid rgba(223,208,178,.92); border-radius: 36rpx; background: linear-gradient(135deg, rgba(252,247,236,.98), rgba(246,238,221,.84)); box-shadow: 0 12rpx 30rpx -24rpx rgba(77,52,32,.65), inset 0 2rpx 0 rgba(255,255,255,.82); }
.hero-wash { position: absolute; right: -66rpx; top: -92rpx; width: 280rpx; height: 280rpx; border-radius: 50%; background: radial-gradient(circle, rgba(225,205,168,.7), rgba(239,228,207,0) 68%); }
.hero { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; min-height: 184rpx; }
.hero-copy { flex: 1; min-width: 0; padding: 4rpx 0 10rpx; }
.hero-eyebrow { margin: 0 0 12rpx; }
.hero-title { font-size: 58rpx; line-height: 1.14; }
.hero-date { display: inline-flex; align-items: center; min-height: 48rpx; margin-top: 18rpx; padding: 0 18rpx; border: 2rpx solid rgba(223,208,178,.82); border-radius: 24rpx; color: var(--sub); background: rgba(255,252,244,.62); font-size: 22rpx; }
.hero-mascot { display: flex; flex: none; align-items: flex-end; justify-content: center; width: 150rpx; height: 170rpx; margin: 0 -4rpx -12rpx 14rpx; }
.drink-picker { margin-top: 24rpx; padding: 22rpx 22rpx 20rpx; border: 2rpx solid rgba(223,208,178,.82); border-radius: 30rpx; background: rgba(252,247,236,.62); }
.picker-title { margin: 0 4rpx 16rpx; color: var(--sub); font-size: 23rpx; font-weight: 600; letter-spacing: 2rpx; }
.drink-pills { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; padding: 2rpx 0 6rpx; }
.drink-pill { min-width: 0; min-height: 64rpx; padding: 0 10rpx; overflow: hidden; font-size: 23rpx; white-space: nowrap; text-overflow: ellipsis; }
.more-pill { color: var(--dim); }
.picker-divider { height: 2rpx; margin: 18rpx 4rpx; background: var(--line-light); }
.temperature-title { margin-bottom: 12rpx; }
.temperature-pills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.temperature-pill { display: flex; align-items: center; justify-content: center; min-height: 66rpx; border: 2rpx solid var(--line); border-radius: 20rpx; color: var(--sub); background: var(--paper-light); font-size: 25rpx; }
.temperature-pill.active { border-color: var(--brown); color: #fbf5e8; background: linear-gradient(160deg, #6b4c37, var(--brown)); box-shadow: 0 10rpx 20rpx -14rpx rgba(60,40,22,.9); }
.section-head { align-items: center; margin: 34rpx 0 12rpx; }
.section-head .eyebrow { margin: 0; }
.section-head .muted { flex: none; line-height: 1.2; }
.day-link { color: var(--brown); }
.bean-pills { width: 100%; white-space: nowrap; }
.bean-pill { display: inline-block; min-width: 210rpx; margin-right: 14rpx; padding: 16rpx 24rpx 18rpx; border: 2rpx solid var(--line); border-radius: 24rpx; background: var(--paper-light); }
.bean-pill.active { border-color: var(--brown); color: #fbf5e8; background: linear-gradient(160deg, #6b4c37, var(--brown)); box-shadow: 0 10rpx 22rpx -16rpx rgba(60,40,22,.9); }
.bean-pill-name { font-size: 26rpx; }
.bean-pill-stock { margin-top: 4rpx; color: var(--dim); font-size: 20rpx; }
.bean-pill.active .bean-pill-stock { color: rgba(251,245,232,.75); }
.mini-progress { height: 6rpx; margin-top: 10rpx; overflow: hidden; border-radius: 6rpx; background: #e1d3b8; }
.mini-progress-fill { width: 0; height: 100%; border-radius: 6rpx; background: var(--brown-light); transition: width .28s ease; }
.bean-pill.active .mini-progress { background: rgba(255,250,235,.28); }
.bean-pill.active .mini-progress-fill { background: #e4c68f; }
.compact-empty { padding: 34rpx 24rpx; }
.empty-action { display: inline-block; margin-top: 12rpx; color: var(--brown); font-weight: 600; }
.cup-card { margin-top: 22rpx; }
.cup-head { align-items: baseline; padding-bottom: 18rpx; border-bottom: 2rpx dashed var(--line-light); }
.cup-title { font-size: 28rpx; }
.cup-price { font-size: 52rpx; font-weight: 700; }
.cost-lines { padding: 6rpx 0 4rpx; }
.cost-line { display: flex; align-items: center; justify-content: space-between; min-height: 62rpx; color: var(--sub); font-size: 24rpx; }
.bean-line { gap: 16rpx; }
.cost-label { flex: none; }
.cost-value { flex: none; }
.gram-editor { display: flex; flex: 1; align-items: center; justify-content: center; gap: 10rpx; }
.gram-button { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border: 2rpx solid rgba(90,65,48,.26); border-radius: 18rpx; color: var(--brown); background: rgba(238,226,204,.7); font-size: 28rpx; line-height: 1; }
.gram-button:active { opacity: .84; }
.gram-input { width: 96rpx; min-height: 52rpx; padding: 0 10rpx; border: 2rpx solid var(--line); border-radius: 16rpx; color: var(--ink); background: var(--paper-light); font-size: 25rpx; text-align: center; }
.gram-unit { flex: none; color: var(--dim); font-size: 22rpx; }
.gram-reset { padding: 8rpx 0 2rpx; color: var(--brown); font-size: 21rpx; text-align: center; }
.nutrition-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.nutrition-grid view { padding: 16rpx 6rpx; border: 2rpx solid var(--line-light); border-radius: 18rpx; background: var(--card); text-align: center; }
.nutrition-grid text { display: block; }
.nutrition-grid text:first-child { font-size: 30rpx; font-weight: 600; }
.nutrition-grid text:last-child { margin-top: 4rpx; color: var(--dim); font-size: 18rpx; }
.complete-button { margin-top: 24rpx; }
.summary-card { padding: 26rpx; border: 2rpx solid var(--line); border-radius: 28rpx; background: var(--paper-light); }
.summary-top { padding-bottom: 20rpx; border-bottom: 2rpx dashed var(--line-light); }
.summary-top text:last-child { font-size: 40rpx; font-weight: 700; }
.summary-grid { grid-template-columns: repeat(4, 1fr); margin-top: 18rpx; }
.summary-grid view { padding: 14rpx 2rpx; }
.log-swipe { position: relative; margin-bottom: 20rpx; overflow: hidden; border-radius: 28rpx; }
.log-delete { position: absolute; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 160rpx; color: #fbf5e8; background: linear-gradient(160deg, #bb5f45, var(--red)); font-size: 26rpx; }
.log-card { position: relative; display: flex; gap: 22rpx; align-items: center; margin-bottom: 0; padding: 22rpx; background: #fcf7ec; transition: transform .22s ease; }
.log-swipe.open .log-card { transform: translateX(-160rpx); }
.log-photo, .coffee-circle { flex: none; width: 92rpx; height: 92rpx; border-radius: 22rpx; }
.coffee-circle { background: radial-gradient(circle, #f1e1c6 0 32%, #c79e70 33% 42%, #5c4230 43% 52%, #3c2a1d 53%); }
.coffee-circle.none { background: radial-gradient(circle, #312217 0 43%, #5c4230 44% 52%, #2a1d14 53%); }
.coffee-circle.coconut { background: radial-gradient(circle, #e8ebdc 0 34%, #bfc7a8 35% 43%, #5c4230 44% 52%, #3c2a1d 53%); }
.log-copy { flex: 1; min-width: 0; }
.calendar-card { padding: 22rpx; }
.calendar-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.calendar-title { font-size: 30rpx; font-weight: 600; }
.calendar-arrow { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border: 2rpx solid var(--line); border-radius: 50%; background: var(--paper-light); font-size: 36rpx; }
.calendar-arrow.disabled { opacity: .25; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.weekday-grid { margin-bottom: 8rpx; color: var(--dim); font-size: 20rpx; text-align: center; }
.calendar-day { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1; overflow: hidden; border: 2rpx solid var(--line-light); border-radius: 16rpx; color: var(--dim); background: var(--paper-light); font-size: 21rpx; }
.calendar-day.blank { border-color: transparent; background: transparent; }
.calendar-day.today { border-color: var(--brown); box-shadow: inset 0 0 0 2rpx var(--brown); }
.calendar-day.future { opacity: .32; }
.calendar-day image { position: absolute; inset: 0; width: 100%; height: 100%; }
.day-number { position: relative; z-index: 2; }
.has-photo .day-number { align-self: flex-start; width: 100%; padding: 4rpx 8rpx; color: white; text-shadow: 0 2rpx 5rpx rgba(0,0,0,.7); }
.calendar-dot { position: absolute; bottom: 7rpx; left: 50%; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--brown); transform: translateX(-50%); }
.calendar-count { position: absolute; z-index: 3; right: 4rpx; bottom: 2rpx; min-width: 22rpx; height: 22rpx; padding: 0 4rpx; border-radius: 12rpx; color: white; background: var(--brown); font-size: 14rpx; line-height: 22rpx; text-align: center; }
.calendar-foot { margin-top: 20rpx; color: var(--dim); font-size: 20rpx; text-align: center; }
.sheet-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; padding: 0 8rpx; border-bottom: 2rpx dashed var(--line-light); }
.rating-mascot { display: flex; justify-content: center; height: 116rpx; }
.rating-wrap { margin: 6rpx 0 28rpx; text-align: center; }
.rating-number { margin-top: 10rpx; color: var(--sub); }
.photo-picker { display: flex; align-items: center; justify-content: center; width: 100%; height: 250rpx; margin-bottom: 28rpx; overflow: hidden; border: 2rpx dashed var(--line); border-radius: 24rpx; color: var(--dim); background: var(--paper-light); }
.photo-picker image { width: 100%; height: 100%; }
.sheet-secondary { margin-top: 16rpx; }
