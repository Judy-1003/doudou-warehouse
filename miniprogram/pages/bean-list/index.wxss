.top-eyebrow { margin-top: 8rpx; }.list-summary { margin-bottom: 28rpx; }.list-card { padding: 4rpx 28rpx; }.bean-row { display: flex; align-items: center; gap: 18rpx; min-height: 108rpx; border-bottom: 2rpx dashed var(--line-light); }.bean-row:last-child { border-bottom: 0; }.bean-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }.bean-copy > text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.row-tail { display: flex; align-items: center; gap: 12rpx; color: var(--sub); }
