.rating { display: inline-flex; gap: 6rpx; }
.star { position: relative; flex: none; color: #c8922c; }
.star-empty { position: absolute; inset: 0; opacity: .48; }
.star-fill { position: absolute; z-index: 1; inset: 0 auto 0 0; overflow: hidden; white-space: nowrap; color: #c8922c; }
.star-fill text { display: block; }
.hit { position: absolute; z-index: 2; top: 0; bottom: 0; width: 50%; }
.hit.left { left: 0; }.hit.right { right: 0; }
