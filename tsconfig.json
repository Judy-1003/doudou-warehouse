{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "module": "CommonJS",
    "target": "ES2020",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./typings"]
  },
  "include": ["./miniprogram/**/*.ts", "./typings/**/*.d.ts"]
}
